{
  "undertone": 1,
  "id": "ntfy",
  "name": "ntfy notifications",
  "version": "1.0.0",
  "description": "Sends a push notification to your phone when a song starts, through ntfy.",
  "settings": [
    {
      "key": "topic",
      "type": "text",
      "label": "Topic",
      "help": "Subscribe to the same topic in the ntfy app. Pick something hard to guess: anyone who knows it can read it.",
      "required": true
    },
    {
      "key": "server",
      "type": "text",
      "label": "Server",
      "default": "https://ntfy.sh",
      "required": true
    }
  ],
  "track": {
    "nowPlaying": {
      "method": "POST",
      "url": "{{&settings.server}}",
      "json": {
        "topic": "{{settings.topic}}",
        "title": "{{track.title}}",
        "message": "{{track.artist}} · {{track.album}}",
        "tags": [
          "musical_note"
        ]
      }
    }
  }
}
