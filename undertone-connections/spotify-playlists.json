{
  "undertone": 1,
  "id": "spotify-playlists",
  "name": "Spotify playlists",
  "version": "1.0.0",
  "description": "Reads public Spotify playlist links so you can import them. Up to the first 100 songs of a playlist.",
  "playlists": [
    {
      "match": "open\\.spotify\\.com/(?:intl-[a-z-]+/)?(?:embed/)?playlist/([A-Za-z0-9]+)",
      "request": {
        "url": "https://open.spotify.com/embed/playlist/{{m1}}",
        "headers": {
          "user-agent": "Mozilla/5.0",
          "accept": "text/html"
        },
        "extract": "<script id=\"__NEXT_DATA__\"[^>]*>(.*?)</script>"
      },
      "name": "props.pageProps.state.data.entity.name",
      "items": "props.pageProps.state.data.entity.trackList",
      "title": "title",
      "artist": "subtitle",
      "artistFirst": ","
    }
  ]
}
